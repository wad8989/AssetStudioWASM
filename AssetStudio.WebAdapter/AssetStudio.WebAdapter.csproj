<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.19.0.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <UseSystemTextJsonSourceGeneration>true</UseSystemTextJsonSourceGeneration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WasmEmitSourceMap>false</WasmEmitSourceMap>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <CopyDebugSymbols>true</CopyDebugSymbols>
    <DebuggerSupport>true</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetStudio\AssetStudio\AssetStudio.csproj" />
    <ProjectReference Include="..\AssetStudio\AssetStudioUtility\AssetStudioUtility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Block the package from being restored -->
    <PackageReference Include="Kyaru.Texture2DDecoder" Version="0.17.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Texture2DDecoderNative.ImportBridge\Texture2DDecoderNative.ImportBridge.csproj" />
  </ItemGroup>
  <!-- C++ texture decoder sources compiled directly into dotnet.native.wasm via NativeFileReference.
       EmccFlags is appended to _EmccCommonFlags which feeds the link-step command; emcc compiles
       each .cpp internally, picking up these flags. Clang auto-adds the source file's directory for
       quoted includes, so crunch/ fp16/ unitycrunch/ sub-headers resolve without an extra -I. -->
  <PropertyGroup Condition="$(_WasmIsPublishing) == true">
    <_DecoderDir>$(ProjectDir)..\AssetStudio\Texture2DDecoderNative</_DecoderDir>
    <EmccFlags>$(EmccFlags) -I"$(_DecoderDir)" -I"$(_DecoderDir)\fp16" -I"$(_DecoderDir)\crunch" -I"$(_DecoderDir)\unitycrunch" -Wno-c++11-narrowing</EmccFlags>
  </PropertyGroup>
  <ItemGroup Condition="$(_WasmIsPublishing) == true">
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\dllmain.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\bcn.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\astc.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\etc.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\pvrtc.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\atc.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\crunch.cpp" />
    <NativeFileReference Include="$(ProjectDir)..\AssetStudio\Texture2DDecoderNative\unitycrunch.cpp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0-preview.6.24327.7" />
  </ItemGroup>
  
  <ItemGroup>
    <TrimmerRootDescriptor Include="linker.xml" />
  </ItemGroup>

  <Target Name="Deploy:Dist" AfterTargets="_AfterWasmBuildApp">
    <ItemGroup>
      <AppBundleFiles Include="$(OutputPath)\AppBundle\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AppBundleFiles)" DestinationFolder="$(ProjectDir)..\dist\AppBundle\%(RecursiveDir)" SkipUnchangedFiles="false" />
    <Message Text="Copied AppBundle" Importance="High" />
  </Target>
  
  <Target Name="Clean:Dist" AfterTargets="Clean">
    <RemoveDir Directories="$(ProjectDir)\..\dist\AppBundle" />
    <RemoveDir Directories="$(ProjectDir)\bin" />
    <RemoveDir Directories="$(ProjectDir)\obj" />
  </Target>

</Project>